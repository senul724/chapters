// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  address   String    @id
  signature String
  user_name String?
  chapters  Chapter[]
}

model Chapter {
  id            Int       @id @default(autoincrement())
  level         Int
  author        User      @relation(fields: [authorAddress], references: [address])
  authorAddress String
  title         String
  rootId        Int?
  root          Chapter?  @relation("BranchRoot", fields: [rootId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branches      Chapter[] @relation("BranchRoot")

  @@index([authorAddress])
  @@index([rootId])
}
